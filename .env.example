# MusicGen service
MUSICGEN_ADMIN_TOKEN=replace-with-a-long-random-token

# Vision service
QWEN_MODEL_PATH=/data/auralink/models/qwen-vl/checkpoint-400-merged-new
PUBLIC_AUDIO_FOLDER=/data/auralink/audio
VISION_UPLOAD_FOLDER=/data/auralink/uploads/vision
VISION_HOST=0.0.0.0
VISION_PORT=5002

# VMM service
HF_ENDPOINT=https://hf-mirror.com
VMM_MODEL_PATH=/data/auralink/models/vmm/musicgen-small
VMM_CHECKPOINT_PATH=/data/auralink/models/vmm/final_model.pth
PUBLIC_AUDIO_FOLDER=/data/auralink/audio
VMM_UPLOAD_FOLDER=/data/auralink/uploads/vmm
VMM_DEVICE=cuda
VMM_HOST=0.0.0.0
VMM_PORT=5001
AUDIOCRAFT_SOURCE_DIR=./vmm-service/third_party/audiocraft
